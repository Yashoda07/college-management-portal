<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Student Performance Portal</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg bg-white border-bottom">
            <div class="container">

                <a class="navbar-brand fw-bold text-primary"
                   asp-page="/Index">
                    Student Performance Portal
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <ul class="navbar-nav ms-auto gap-lg-2">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Dashboard">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Courses/Index">
                                Courses
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Faculty/Index">
                                Faculty
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Marks/Index">
                                Marks
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Attendance/Index">
                                Attendance
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="border-top bg-white py-4">
        <div class="container text-center text-secondary">
            &copy; 2026 Student Performance Portal
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>