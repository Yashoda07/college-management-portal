@page
@model StudentPerformancePortal.Pages.Students.IndexModel

@{
    ViewData["Title"] = "Students";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Students</h1>
            <p class="text-secondary mb-0">
                View and manage student records.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a href="/Dashboard" class="btn btn-outline-primary">
                ← Dashboard
            </a>

            <a href="/Students/Create" class="btn btn-primary">
                + Add Student
            </a>
        </div>
    </div>

    <div class="dashboard-card">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Student No.</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Admission Year</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var student in Model.Students)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">
                                    @student.StudentNumber
                                </span>
                            </td>

                            <td>
                                @student.FirstName @student.LastName
                            </td>

                            <td>
                                @student.Email
                            </td>

                            <td>
                                @student.Department?.DepartmentName
                            </td>

                            <td>
                                @student.AdmissionYear
                            </td>

                            <td>
                                <a href="/Students/Edit?id=@student.StudentId"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <a href="/Students/Delete?id=@student.StudentId"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        @if (!Model.Students.Any())
        {
            <div class="text-center py-5">
                <p class="text-secondary mb-0">
                    No students found.
                </p>
            </div>
        }

    </div>

</div>